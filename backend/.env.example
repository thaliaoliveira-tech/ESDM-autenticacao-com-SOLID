# ---------------------------------------------------------------------------
# Copie este arquivo para .env antes de rodar o projeto:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
# ---------------------------------------------------------------------------

# Aplicacao
NODE_ENV=development
PORT=3000

# Banco de dados (SQLite via Prisma)
# O caminho e relativo a pasta prisma/
DATABASE_URL="file:./dev.db"

# JWT
# Em producao gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="1h"

# Seed de desenvolvimento
SEED_USER_EMAIL="demo@example.com"
SEED_USER_PASSWORD="Demo@123"
SEED_USER_NAME="Usuario Demo"
SEED_USER_USERNAME="demo"

# Sessao: refresh token rotativo (dias)
REFRESH_TOKEN_TTL_DAYS=30

# Recuperacao de senha
# Validade do link em minutos.
PASSWORD_RESET_TTL_MINUTES=30
# Base do link devolvido por POST /auth/password/forgot; o token e anexado ao final
# (deep link do app ou pagina web). Nao ha envio de e-mail.
PASSWORD_RESET_URL="sintetiza://redefinir-senha?token="

# Convidados sem sessao ativa sao removidos (com os dados) apos N dias.
GUEST_RETENTION_DAYS=30

# CORS: origens permitidas separadas por virgula (vazio = qualquer origem).
CORS_ORIGINS=""

# Job de manutencao (limpa sessoes, links e convidados expirados). Padrao: true, exceto em testes.
JOBS_ENABLED=

# IA (chat): DeepSeek via OpenRouter. Sem chave, o chat responde 503.
# Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TIMEOUT_MS=120000
