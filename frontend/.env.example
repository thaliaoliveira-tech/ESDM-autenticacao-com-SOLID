# Copie para .env se precisar mudar os padroes.

# Endereco da API NestJS usado pelo proxy do Vite (/api -> BACKEND_URL).
BACKEND_URL=http://localhost:3000

# Porta do servidor de desenvolvimento.
PORT=5173

# Opcional: URL da API acessada direto pelo navegador, sem o proxy
# (ex.: build publicado em outro dominio). Exige CORS_ORIGINS no backend.
# VITE_API_URL=http://localhost:3000
